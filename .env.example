# Boxit — environment template
# Copy to .env.local for local dev, or set these in your host (Vercel) for prod.
# Every variable is OPTIONAL: the site runs without them (forms log to the
# server console, analytics is a no-op, payments stay in manual mode).

# --- Lead / order notifications (Resend) ---------------------------------
# When both are set, contact/quote/quiz/sample-kit leads are emailed to you.
# Get a key at https://resend.com. The "from" domain (boxit.pk) must be verified.
RESEND_API_KEY=
LEADS_NOTIFY_EMAIL=info@boxit.pk

# --- Analytics (client-side, safe to expose) -----------------------------
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Leave blank to disable.
NEXT_PUBLIC_GA_ID=
# Meta (Facebook) Pixel ID. Leave blank to disable.
NEXT_PUBLIC_FB_PIXEL_ID=

# --- Payments ------------------------------------------------------------
# "manual" (default) = Cash on Delivery + bank transfer + wallet-by-receipt.
# Set to a real gateway (e.g. "payfast" / "safepay") only once wallet/card
# checkout is wired up in src/lib/payments.ts.
PAYMENT_PROVIDER=manual
